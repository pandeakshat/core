---
import "../styles/global.css"
import { ThemeToggle } from "../components/ThemeToggle"
const { title = "Akshat Pande", description = "Data Scientist & AI Engineer" } = Astro.props
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <header class="border-b border-border/60">
      <div class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between px-6">
        <a href="/" class="font-semibold">PandeAkshat</a>
        <nav class="hidden sm:flex items-center gap-4 text-sm">
          <a href="/resume">Resume</a>
          <a href="/projects">Projects</a>
          <a href="/blog">Blog</a>
          <a href="/hub">AI/Data Hub</a>
          <a href="/contact">Contact</a>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-6 py-12">
      <slot />
    </main>
    <footer class="border-t border-border/60">
      <div class="mx-auto max-w-6xl py-8 text-sm text-foreground/70">
        © {new Date().getFullYear()} Akshat Pande
      </div>
    </footer>
  </body>
</html>

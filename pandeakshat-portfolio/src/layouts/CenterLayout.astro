---
import "../styles/global.css"
const { title = "PandeAkshat", description = "" } = Astro.props
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-background text-foreground grid place-items-center p-6">
    <slot />
  </body>
</html>

---
import LinksView from "../components/links/LinksView"
import BaseLayout from "../layouts/CenterLayout.astro"
import links from "../data/links"
import BackHomeButton from "../components/common/BackHomeButton"
---

<BaseLayout title="Links — Akshat Pande">
  <LinksView
    client:load
    title="Links & Profiles"
    subtitle="Find all my platforms and profiles in one place."
    links={links}
  />
  <BackHomeButton client:load position="bottom-right" />
</BaseLayout>

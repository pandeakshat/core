---
import BaseLayout from "../../layouts/CenterLayout.astro";
import { contentfulClient, type Project } from "../../lib/contentful";
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";

// 1. Generate Paths: Fetch ALL projects so Astro knows what pages to build
export async function getStaticPaths() {
  const entries = await contentfulClient.getEntries<Project>({
    content_type: "project",
  });

  return entries.items.map((item) => ({
    params: { slug: item.fields.slug },
    props: { project: item.fields }, // Pass the whole project data to the page
  }));
}

// 2. Get the data passed from getStaticPaths
const { project } = Astro.props;
const { title, content, coverImage } = project;

// 3. Convert Contentful Rich Text to HTML
const contentHtml = content ? documentToHtmlString(content) : "";

// 4. Handle Cover Image URL (if it exists)
const imageUrl = coverImage?.fields?.file?.url 
  ? `https:${coverImage.fields.file.url}` 
  : null;
---

<BaseLayout title={title}>
  <article class="prose prose-neutral dark:prose-invert max-w-3xl mx-auto py-8 px-4">
    {/* Optional: Show the cover image at the top of the article */}
    {imageUrl && (
      <img 
        src={imageUrl} 
        alt={title} 
        class="w-full h-64 object-cover rounded-xl mb-8 shadow-sm"
      />
    )}

    <h1 class="mb-4 text-4xl font-bold">{title}</h1>
    
    {/* Render the converted HTML */}
    <div set:html={contentHtml}></div>
  </article>

  <div class="mt-10 flex justify-center">
    <a href="/projects" class="rounded-full px-4 py-2 border border-border hover:bg-accent/10 transition mb-10">
      ← Back to Projects
    </a>
  </div>
</BaseLayout>
---
import BaseLayout from "../../layouts/CenterLayout.astro"
import { Markdown } from "astro/components"
import projects from "../../data/projects"

// 1️⃣ Tell Astro which routes to build
export async function getStaticPaths() {
  return projects.map((p) => ({
    params: { id: p.id },
    props: { project: p },
  }))
}

// 2️⃣ Grab the current project data
const { project } = Astro.props

// 3️⃣ Load the project's Markdown content dynamically
const markdownFile = await import(`../../data/project-md/${project.id}.md`)
const { default: Content } = markdownFile
---

<BaseLayout title={`${project.title} — Akshat Pande`}>
  <section class="max-w-3xl mx-auto py-12">
    <h1 class="text-3xl font-semibold mb-3">{project.title}</h1>
    <p class="text-foreground/70 mb-6">{project.summary}</p>

    <article class="prose prose-neutral dark:prose-invert max-w-none">
      <Content />
    </article>

    <div class="mt-10 flex justify-center">
      <a
        href="/projects"
        class="border rounded-full px-4 py-2 hover:bg-accent/10 transition"
      >
        ← Back to Projects
      </a>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/CenterLayout.astro";
import { contentfulClient, type BlogPost } from "../../lib/contentful";
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";

export async function getStaticPaths() {
  const entries = await contentfulClient.getEntries<BlogPost>({
    content_type: "blog",
  });

  return entries.items.map((item) => ({
    params: { slug: item.fields.slug },
    props: { post: item.fields },
  }));
}

const { post } = Astro.props;
const { title, content, coverImage, date, readTime } = post;

const contentHtml = content ? documentToHtmlString(content) : "";
const coverUrl = coverImage?.fields?.file?.url ? `https:${coverImage.fields.file.url}` : null;
const formattedDate = new Date(date).toLocaleDateString("en-US", { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title}>
  <article class="prose prose-neutral dark:prose-invert max-w-3xl mx-auto py-8 px-4">
    {coverUrl && (
      <img src={coverUrl} alt={title} class="w-full h-64 object-cover rounded-xl mb-6 shadow-sm" />
    )}
    
    <div class="mb-8 text-center">
      <h1 class="text-4xl font-bold mb-2">{title}</h1>
      <div class="text-sm text-foreground/60">
        <span>{formattedDate}</span> • <span>{readTime}</span>
      </div>
    </div>

    <div set:html={contentHtml}></div>
  </article>

  <div class="mt-10 flex justify-center mb-10">
    <a href="/blog" class="rounded-full px-4 py-2 border border-border hover:bg-accent/10 transition">
      ← Back to Articles
    </a>
  </div>
</BaseLayout>
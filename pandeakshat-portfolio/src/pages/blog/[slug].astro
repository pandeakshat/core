---
import BaseLayout from "../../layouts/CenterLayout.astro"
import blogs from "../../data/blogs"

export async function getStaticPaths() {
  return blogs.map((b) => ({
    params: { slug: b.id },
    props: { blog: b },
  }))
}

const { blog } = Astro.props
const markdownFile = await import(`../../data/blog-md/${blog.id}.md`)
const { default: Content } = markdownFile
---

<BaseLayout title={`${blog.title} — Akshat Pande`}>
  <section class="max-w-3xl mx-auto py-12">
    <h1 class="text-3xl font-semibold mb-2">{blog.title}</h1>
    <p class="text-sm text-foreground/60 mb-6">{blog.date} · {blog.readTime}</p>

    <article class="prose prose-neutral dark:prose-invert max-w-none">
      <Content />
    </article>

    <!-- Medium Button -->
    {blog.medium && (
      <div class="mt-8 flex justify-center">
        <a
          href={blog.medium}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 border border-border rounded-full hover:bg-accent/10 transition"
        >
          Read on Medium →
        </a>
      </div>
    )}

    <div class="mt-10 flex justify-center">
      <a href="/blog" class="border rounded-full px-4 py-2 hover:bg-accent/10">
        ← Back to Blog
      </a>
    </div>
  </section>
</BaseLayout>

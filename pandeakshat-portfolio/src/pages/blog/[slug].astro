---
import BaseLayout from "../../layouts/CenterLayout.astro"
import { getCollection } from "astro:content"
import { ArrowLeft } from "lucide-react"

export async function getStaticPaths() {
  const posts = await getCollection("blog")
  return await Promise.all(
    posts.map(async (post) => {
      const { Content } = await post.render() // ← Get the compiled markdown component
      return {
        params: { slug: post.slug },
        props: { post, Content },
      }
    })
  )
}

const { post, Content } = Astro.props
const { data } = post
---

<BaseLayout title={data.title}>
  <a href="/blog" class="inline-flex items-center mb-4 text-sm text-gray-500 hover:text-foreground">
    <ArrowLeft size={16} class="mr-1" /> Back to Blogs
  </a>

  <article class="prose prose-neutral dark:prose-invert max-w-3xl mx-auto">
    <h1>{data.title}</h1>
    <p class="text-sm text-gray-500 mb-6">{data.date} — {data.readTime}</p>

    <!-- ✅ Render compiled markdown -->
    <Content />
  </article>
</BaseLayout>
